{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Backend Terminal",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoExit",
                "-Command",
                "Set-Location '${workspaceFolder}/backend'"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "panel": "dedicated",
                "group": "backend"
            }
        },
        {
            "label": "Frontend Terminal",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoExit",
                "-Command",
                "Set-Location '${workspaceFolder}/frontend'"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "panel": "dedicated",
                "group": "frontend"
            }
        }
    ]
}